ex":373},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":9,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.12549019607843137,"green":0.12941176470588237,"blue":0.1411764705882353}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"createShape":{"objectId":"rsk0w0b","shapeType":"ROUND_RECTANGLE","elementProperties":{"pageObjectId":"risk10","size":{"width":{"magnitude":5408676,"unit":"EMU"},"height":{"magnitude":1627632,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":548640,"translateY":3611880,"unit":"EMU"}}}},{"updateShapeProperties":{"objectId":"rsk0w0b","shapeProperties":{"shapeBackgroundFill":{"solidFill":{"alpha":1,"color":{"rgbColor":{"red":0.9725490196078431,"green":0.9764705882352941,"blue":0.9803921568627451}}}},"outline":{"propertyState":"NOT_RENDERED"}},"fields":"shapeBackgroundFill.solidFill.color,outline.propertyState"}},{"createShape":{"objectId":"rsk0w0","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"risk10","size":{"width":{"magnitude":5042916,"unit":"EMU"},"height":{"magnitude":1389888,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":731520,"translateY":3730752,"unit":"EMU"}}}},{"insertText":{"objectId":"rsk0w0","insertionIndex":0,"text":"Limitations of this research\nSurvey n=31, a convenience sample skewed to engaged users. Four interviews, not twelve. The discovery engine reads public posts, which over-represent failures loud enough to complain about and miss the silent ones entirely, which is the exact bias the survey caught. Impact sizing is an order-of-magnitude estimate and every figure is labelled as one.\n"}},{"updateTextStyle":{"objectId":"rsk0w0","textRange":{"type":"FIXED_RANGE","startIndex":0,"endIndex":29},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":11.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.12549019607843137,"green":0.12941176470588237,"blue":0.1411764705882353}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"rsk0w0","textRange":{"type":"FIXED_RANGE","startIndex":29,"endIndex":381},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":10,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"createShape":{"objectId":"rsk0w1b","shapeType":"ROUND_RECTANGLE","elementProperties":{"pageObjectId":"risk10","size":{"width":{"magnitude":5408676,"unit":"EMU"},"height":{"magnitude":1627632,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":6231636,"translateY":3611880,"unit":"EMU"}}}},{"updateShapeProperties":{"objectId":"rsk0w1b","shapeProperties":{"shapeBackgroundFill":{"solidFill":{"alpha":1,"color":{"rgbColor":{"red":0.9725490196078431,"green":0.9764705882352941,"blue":0.9803921568627451}}}},"outline":{"propertyState":"NOT_RENDERED"}},"fields":"shapeBackgroundFill.solidFill.color,outline.propertyState"}},{"createShape":{"objectId":"rsk0w1","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"risk10","size":{"width":{"magnitude":5042916,"unit":"EMU"},"height":{"magnitude":1389888,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":6414516,"translateY":3730752,"unit":"EMU"}}}},{"insertText":{"objectId":"rsk0w1","insertionIndex":0,"text":"Edge cases the MVP must not break\nShared and group libraries, where \u201cmy sister\u201d is ambiguous across accounts. Photos with no usable metadata at all. A user who genuinely does not have the photo: the app must be able to say so, which one participant could not determine for themselves. Non-English cue words. Faces that have aged past their own cluster, which breaks the one AI feature users currently trust.\n"}},{"updateTextStyle":{"objectId":"rsk0w1","textRange":{"type":"FIXED_RANGE","startIndex":0,"endIndex":34},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":11.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.12549019607843137,"green":0.12941176470588237,"blue":0.1411764705882353}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"rsk0w1","textRange":{"type":"FIXED_RANGE","startIndex":34,"endIndex":408},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":10,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"createShape":{"objectId":"rsk0ft","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"risk10","size":{"width":{"magnitude":11091672,"unit":"EMU"},"height":{"magnitude":914400,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":548640,"translateY":5376672,"unit":"EMU"}}}},{"insertText":{"objectId":"rsk0ft","insertionIndex":0,"text":"The honest summary:  the strongest evidence in this project is a single controlled test on one library, and the largest number in it is an estimate built on a 31-person survey. Everything here is sized to be falsifiable rather than impressive, and the kill criteria are written so that a failed MVP test reads as a result rather than as a failure of the project.\n"}},{"updateTextStyle":{"objectId":"rsk0ft","textRange":{"type":"FIXED_RANGE","startIndex":0,"endIndex":19},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":10.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.8509803921568627,"green":0.18823529411764706,"blue":0.1450980392156863}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"rsk0ft","textRange":{"type":"FIXED_RANGE","startIndex":19,"endIndex":363},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":10.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}}]
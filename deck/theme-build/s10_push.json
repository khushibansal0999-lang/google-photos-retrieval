eProperties":{"objectId":"rsk0dt3","shapeProperties":{"shapeBackgroundFill":{"solidFill":{"alpha":1,"color":{"rgbColor":{"red":0.09411764705882353,"green":0.5019607843137255,"blue":0.2196078431372549}}}},"outline":{"propertyState":"NOT_RENDERED"}},"fields":"shapeBackgroundFill.solidFill.color,outline.propertyState"}},{"createShape":{"objectId":"rsk0c0b","shapeType":"ROUND_RECTANGLE","elementProperties":{"pageObjectId":"risk10","size":{"width":{"magnitude":2601468,"unit":"EMU"},"height":{"magnitude":2487168,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":548640,"translateY":1188720,"unit":"EMU"}}}},{"updateShapeProperties":{"objectId":"rsk0c0b","shapeProperties":{"shapeBackgroundFill":{"solidFill":{"alpha":1,"color":{"rgbColor":{"red":0.9882352941176471,"green":0.9098039215686274,"blue":0.9019607843137255}}}},"outline":{"propertyState":"NOT_RENDERED"}},"fields":"shapeBackgroundFill.solidFill.color,outline.propertyState"}},{"createShape":{"objectId":"rsk0c0","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"risk10","size":{"width":{"magnitude":2272284,"unit":"EMU"},"height":{"magnitude":2267712,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":713232,"translateY":1298448,"unit":"EMU"}}}},{"insertText":{"objectId":"rsk0c0","insertionIndex":0,"text":"A confident wrong answer costs more trust than a blank one\nWHY IT HAPPENS\nGoogle already lived this. Ask Photos was paused in 2026 after users said it found less than classic search.\nTHE SIGNAL\nRe-search rate within 24 hours.\nMITIGATION, AND WHAT IT COSTS\nShow why each result matched and keep classic results alongside. Costs us screen space and a slower first paint.\n"}},{"updateTextStyle":{"objectId":"rsk0c0","textRange":{"type":"FIXED_RANGE","startIndex":0,"endIndex":59},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":10.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.8509803921568627,"green":0.18823529411764706,"blue":0.1450980392156863}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"rsk0c0","textRange":{"type":"FIXED_RANGE","startIndex":59,"endIndex":74},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":8,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.8509803921568627,"green":0.18823529411764706,"blue":0.1450980392156863}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"rsk0c0","textRange":{"type":"FIXED_RANGE","startIndex":74,"endIndex":183},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":9,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"rsk0c0","textRange":{"type":"FIXED_RANGE","startIndex":183,"endIndex":194},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":8,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.8509803921568627,"green":0.18823529411764706,"blue":0.1450980392156863}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"rsk0c0","textRange":{"type":"FIXED_RANGE","startIndex":194,"endIndex":226},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":9,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"rsk0c0","textRange":{"type":"FIXED_RANGE","startIndex":226,"endIndex":256},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":8,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.8509803921568627,"green":0.18823529411764706,"blue":0.1450980392156863}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"rsk0c0","textRange":{"type":"FIXED_RANGE","startIndex":256,"endIndex":369},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":9,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.12549019607843137,"green":0.12941176470588237,"blue":0.1411764705882353}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"createShape":{"objectId":"rsk0c1b","shapeType":"ROUND_RECTANGLE","elementProperties":{"pageObjectId":"risk10","size":{"width":{"magnitude":2601468,"unit":"EMU"},"height":{"magnitude":2487168,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":3378708,"translateY":1188720,"unit":"EMU"}}}},{"updateShapeProperties":{"objectId":"rsk0c1b","shapeProperties":{"shapeBackgroundFill":{"solidFill":{"alpha":1,"color":{"rgbColor":{"red":0.9725490196078431,"green":0.9764705882352941,"blue":0.9803921568627451}}}},"outline":{"propertyState":"NOT_RENDERED"}},"fields":"shapeBackgroundFill.solidFill.color,outline.propertyState"}},{"createShape":{"objectId":"rsk0c1","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"risk10","size":{"width":{"magnitude":2272284,"unit":"EMU"},"height":{"magnitude":2267712,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":3543300,"translateY":1298448,"unit":"EMU"}}}},{"insertText":{"objectId":"rsk0c1","insertionIndex":0,"text":"The clarifying question becomes an interrogation\nWHY IT HAPPENS\nConfidence scoring treats an unambiguous phrase as ambiguous, so every query gets interrupted.\nTHE SIGNAL\nQuestions per session above 0.4, or a skip rate above 50%.\nMITIGATION, AND WHAT IT COSTS\nFire only below 0.75 confidence, hard cap one per session. Costs us some genuinely ambiguous cases, which return a wider set instead.\n"}},{"updateTextStyle":{"objectId":"rsk0c1","textRange":{"type":"FIXED_RANGE","startIndex":0,"endIndex":49},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":10.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.12549019607843137,"green":0.12941176470588237,"blue":0.1411764705882353}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"rsk0c1","textRange":{"type":"FIXED_RANGE","startIndex":49,"endIndex":64},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":8,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.8509803921568627,"green":0.18823529411764706,"blue":0.1450980392156863}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"rsk0c1","textRange":{"type":"FIXED_RANGE","startIndex":64,"endIndex":159},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":9,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"rsk0c1","textRange":{"type":"FIXED_RANGE","startIndex":159,"endIndex":170},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":8,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.8509803921568627,"green":0.18823529411764706,"blue":0.1450980392156863}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"rsk0c1","textRange":{"type":"FIXED_RANGE","startIndex":170,"endIndex":229},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":9,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"rsk0c1","textRange":{"type":"FIXED_RANGE","startIndex":229,"endIndex":259},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":8,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.8509803921568627,"green":0.18823529411764706,"blue":0.1450980392156863}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"rsk0c1","textRange":{"type":"FIXED_RANGE","startIndex":259,"endIndex":393},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":9,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.12549019607843137,"green":0.12941176470588237,"blue":0.1411764705882353}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"createShape":{"objectId":"rsk0c2b","shapeType":"ROUND_RECTANGLE","elementProperties":{"pageObjectId":"risk10","size":{"width":{"magnitude":2601468,"unit":"EMU"},"height":{"magnitude":2487168,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":6208776,"translateY":1188720,"unit":"EMU"}}}},{"updateShapeProperties":{"objectId":"rsk0c2b","shapeProperties":{"shapeBackgroundFill":{"solidFill":{"alpha":1,"color":{"rgbColor":{"red":0.9725490196078431,"green":0.9764705882352941,"blue":0.9803921568627451}}}},"outline":{"propertyState":"NOT_RENDERED"}},"fields":"shapeBackgroundFill.solidFill.color,outline.propertyState"}},{"createShape":{"objectId":"rsk0c2","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"risk10","size":{"width":{"magnitude":2272284,"unit":"EMU"},"height":{"magnitude":2267712,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":6373368,"translateY":1298448,"unit":"EMU"}}}},{"insertText":{"objectId":"rsk0c2","insertionIndex":0,"text":"A seeded demo library flatters the result\nWHY IT HAPPENS\n120 items is not 75,000. Ambiguity is rarer in a small library, which is what our P2 and P3 contrast showed.\nTHE SIGNAL\nTesters reporting that it felt unrealistic.\nMITIGATION, AND WHAT IT COSTS\nSeed from the real interview failures and state the limit on the MVP slide. Costs us the right to claim the result generalises.\n"}},{"updateTextStyle":{"objectId":"rsk0c2","textRange":{"type":"FIXED_RANGE","startIndex":0,"endIndex":42},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":10.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.12549019607843137,"green":0.12941176470588237,"blue":0.1411764705882353}}}},"fields
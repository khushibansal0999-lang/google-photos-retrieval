,"endIndex":379},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":9,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.12549019607843137,"green":0.12941176470588237,"blue":0.1411764705882353}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"createShape":{"objectId":"rsk0c3b","shapeType":"ROUND_RECTANGLE","elementProperties":{"pageObjectId":"risk10","size":{"width":{"magnitude":2601468,"unit":"EMU"},"height":{"magnitude":2487168,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":9038844,"translateY":1188720,"unit":"EMU"}}}},{"updateShapeProperties":{"objectId":"rsk0c3b","shapeProperties":{"shapeBackgroundFill":{"solidFill":{"alpha":1,"color":{"rgbColor":{"red":0.9725490196078431,"green":0.9764705882352941,"blue":0.9803921568627451}}}},"outline":{"propertyState":"NOT_RENDERED"}},"fields":"shapeBackgroundFill.solidFill.color,outline.propertyState"}},{"createShape":{"objectId":"rsk0c3","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"risk10","size":{"width":{"magnitude":2272284,"unit":"EMU"},"height":{"magnitude":2267712,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":9203436,"translateY":1298448,"unit":"EMU"}}}},{"insertText":{"objectId":"rsk0c3","insertionIndex":0,"text":"Interpretation needs history, and history is sensitive\nWHY IT HAPPENS\nJudging whether \u201clast August\u201d is ambiguous requires multi-year capture patterns for that person.\nTHE SIGNAL\nOpt-out rate and privacy complaints.\nMITIGATION, AND WHAT IT COSTS\nRun on the existing on-device index; nothing new leaves the device. Costs us cross-device accuracy for users who switch phones.\n"}},{"updateTextStyle":{"objectId":"rsk0c3","textRange":{"type":"FIXED_RANGE","startIndex":0,"endIndex":55},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":10.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.12549019607843137,"green":0.12941176470588237,"blue":0.1411764705882353}}}},"fields":"bold,
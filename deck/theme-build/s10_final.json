:0.1411764705882353}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"rsk0c2","textRange":{"type":"FIXED_RANGE","startIndex":55,"endIndex":66},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":14,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.8509803921568627,"green":0.18823529411764706,"blue":0.1450980392156863}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"rsk0c2","textRange":{"type":"FIXED_RANGE","startIndex":66,"endIndex":103},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":14,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"rsk0c2","textRange":{"type":"FIXED_RANGE","startIndex":103,"endIndex":128},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":14,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.8509803921568627,"green":0.18823529411764706,"blue":0.1450980392156863}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"rsk0c2","textRange":{"type":"FIXED_RANGE","startIndex":128,"endIndex":243},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":14,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.12549019607843137,"green":0.12941176470588237,"blue":0.1411764705882353}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"createShape":{"objectId":"rsk0wb","shapeType":"ROUND_RECTANGLE","elementProperties":{"pageObjectId":"risk10","size":{"width":{"magnitude":11091672,"unit":"EMU"},"height":{"magnitude":1481328,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":548640,"translateY":3913632,"unit":"EMU"}}}},{"updateShapeProperties":{"objectId":"rsk0wb","shapeProperties":{"shapeBackgroundFill":{"solidFill":{"alpha":1,"color":{"rgbColor":{"red":0.9725490196078431,"green":0.9764705882352941,"blue":0.9803921568627451}}}},"outline":{"propertyState":"NOT_RENDERED"}},"fields":"shapeBackgroundFill.solidFill.color,outline.propertyState"}},{"createShape":{"objectId":"rsk0w","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"risk10","size":{"width":{"magnitude":10725912,"unit":"EMU"},"height":{"magnitude":1225296,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":731520,"translateY":4041648,"unit":"EMU"}}}},{"insertText":{"objectId":"rsk0w","insertionIndex":0,"text":"What this research cannot tell you\nSurvey n=31, skewed to engaged users. Four interviews, not twelve. The discovery engine reads public posts, which over-represent the failures loud enough to complain about. A 120-item demo library is not 75,000, and ambiguity is rarer in a small one. Impact sizing is an order-of-magnitude estimate, labelled as one.\n"}},{"updateTextStyle":{"objectId":"rsk0w","textRange":{"type":"FIXED_RANGE","startIndex":0,"endIndex":35},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":16,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.12549019607843137,"green":0.12941176470588237,"blue":0.1411764705882353}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"rsk0w","textRange":{"type":"FIXED_RANGE","startIndex":35,"endIndex":352},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":14,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"createShape":{"objectId":"rsk0ft","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"risk10","size":{"width":{"magnitude":11091672,"unit":"EMU"},"height":{"magnitude":731520,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":548640,"translateY":5541264,"unit":"EMU"}}}},{"insertText":{"objectId":"rsk0ft","insertionIndex":0,"text":"The honest summary:  the strongest evidence here is one controlled test on one library, and the largest number is an estimate off a 31-person survey. Everything is sized to be falsifiable rather than impressive.\n"}},{"updateTextStyle":{"objectId":"rsk0ft","textRange":{"type":"FIXED_RANGE","startIndex":0,"endIndex":19},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":14,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.8509803921568627,"green":0.18823529411764706,"blue":0.1450980392156863}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"rsk0ft","textRange":{"type":"FIXED_RANGE","startIndex":19,"endIndex":212},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":14,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}}]
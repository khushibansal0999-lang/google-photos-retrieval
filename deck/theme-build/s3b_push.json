ne who simply reported \u201cgiven it was a document, I was unable to exactly locate it\u201d. Documents are also the retrievals under the most time pressure.\n"}},{"updateTextStyle":{"objectId":"res3c0","textRange":{"type":"FIXED_RANGE","startIndex":0,"endIndex":28},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":11,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.8509803921568627,"green":0.18823529411764706,"blue":0.1450980392156863}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"res3c0","textRange":{"type":"FIXED_RANGE","startIndex":28,"endIndex":277},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":10,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"createShape":{"objectId":"res3c1b","shapeType":"ROUND_RECTANGLE","elementProperties":{"pageObjectId":"p5","size":{"width":{"magnitude":3545129,"unit":"EMU"},"height":{"magnitude":1719072,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":4322369,"translateY":3822192,"unit":"EMU"}}}},{"updateShapeProperties":{"objectId":"res3c1b","shapeProperties":{"shapeBackgroundFill":{"solidFill":{"alpha":1,"color":{"rgbColor":{"red":0.9725490196078431,"green":0.9764705882352941,"blue":0.9803921568627451}}}},"outline":{"propertyState":"NOT_RENDERED"}},"fields":"shapeBackgroundFill.solidFill.color,outline.propertyState"}},{"createShape":{"objectId":"res3c1","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"p5","size":{"width":{"magnitude":3179369,"unit":"EMU"},"height":{"magnitude":1481328,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":4505249,"translateY":3941064,"unit":"EMU"}}}},{"insertText":{"objectId":"res3c1","insertionIndex":0,"text":"Face search breaks as libraries deepen\nIt worked for the participant with 5,000 photos, who found a date-blind photo by face and sorted descending. It failed for the participant with 75,000, because a face from 20 years ago does not match the current cluster.\n"}},{"updateTextStyle":{"objectId":"res3c1","textRange":{"type":"FIXED_RANGE","startIndex":0,"endIndex":39},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":11,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.12549019607843137,"green":0.12941176470588237,"blue":0.1411764705882353}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"res3c1","textRange":{"type":"FIXED_RANGE","startIndex":39,"endIndex":260},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":10,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"createShape":{"objectId":"res3c2b","shapeType":"ROUND_RECTANGLE","elementProperties":{"pageObjectId":"p5","size":{"width":{"magnitude":3545129,"unit":"EMU"},"height":{"magnitude":1719072,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":8096098,"translateY":3822192,"unit":"EMU"}}}},{"updateShapeProperties":{"objectId":"res3c2b","shapeProperties":{"shapeBackgroundFill":{"solidFill":{"alpha":1,"color":{"rgbColor":{"red":0.9725490196078431,"green":0.9764705882352941,"blue":0.9803921568627451}}}},"outline":{"propertyState":"NOT_RENDERED"}},"fields":"shapeBackgroundFill.solidFill.color,outline.propertyState"}},{"createShape":{"objectId":"res3c2","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"p5","size":{"width":{"magnitude":3179369,"unit":"EMU"},"height":{"magnitude":1481328,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":8278978,"translateY":3941064,"unit":"EMU"}}}},{"insertText":{"objectId":"res3c2","insertionIndex":0,"text":"Four out of four route around the app\nRe-photograph the document, file it in Drive instead, or give up and wait for it to surface by accident. None of this appears in telemetry as a failed search.\n"}},{"updateTextStyle":{"objectId":"res3c2","textRange":{"type":"FIXED_RANGE","startIndex":0,"endIndex":38},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":11,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.12549019607843137,"green":0.12941176470588237,"blue":0.1411764705882353}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"res3c2","textRange":{"type":"FIXED_RANGE","startIndex":38,"endIndex":197},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":10,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"createShape":{"objectId":"res3ft","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"p5","size":{"width":{"magnitude":11091672,"unit":"EMU"},"height":{"magnitude":822960,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":548640,"translateY":5650992,"unit":"EMU"}}}},{"insertText":{"objectId":"res3ft","insertionIndex":0,"text":"Method:  live retrieval tasks on participants\u2019 own libraries, plus a Google Form survey (n=31). Four interviews complete, P5 and P6 in progress. Participants anonymised.\nHypothesis dropped:  multi-account fragmentation is 0 for 4. Every participant with several accounts said it has never made a photo harder to find, so it is out of the deck rather than presented as a theme on one data point.\n"}},{"updateTextStyle":{"objectId":"res3ft","textRange":{"type":"FIXED_RANGE","startIndex":0,"endIndex":7},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":9.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.12549019607843137,"green":0.12941176470588237,"blue":0.1411764705882353}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"res3ft","textRange":{"type":"FIXED_RANGE","startIndex":7,"endIndex":170},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":9.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"res3ft","textRange":{"type":"FIXED_RANGE","startIndex":170,"endIndex":189},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":9.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.8509803921568627,"green":0.18823529411764706,"blue":0.1450980392156863}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"res3ft","textRange":{"type":"FIXED_RANGE","startIndex":189,"endIndex":395},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":9.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}}]
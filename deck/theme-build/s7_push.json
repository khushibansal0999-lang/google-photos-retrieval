jectId":"chl7d2b","shapeProperties":{"shapeBackgroundFill":{"solidFill":{"alpha":1,"color":{"rgbColor":{"red":0.9882352941176471,"green":0.9098039215686274,"blue":0.9019607843137255}}}},"outline":{"propertyState":"NOT_RENDERED"}},"fields":"shapeBackgroundFill.solidFill.color,outline.propertyState"}},{"createShape":{"objectId":"chl7d2","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"chal7","size":{"width":{"magnitude":3179369,"unit":"EMU"},"height":{"magnitude":1444752,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":8278978,"translateY":4133088,"unit":"EMU"}}}},{"insertText":{"objectId":"chl7d2","insertionIndex":0,"text":"What stops a competitor copying it?\nThe interaction is copyable in a week, and we should say so. The moat is underneath: judging whether \u201clast August\u201d is ambiguous for this user needs their multi-year history, it runs on the existing index so nothing new leaves the device, and it ships where the failure happens.\n"}},{"updateTextStyle":{"objectId":"chl7d2","textRange":{"type":"FIXED_RANGE","startIndex":0,"endIndex":36},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":11,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.8509803921568627,"green":0.18823529411764706,"blue":0.1450980392156863}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"chl7d2","textRange":{"type":"FIXED_RANGE","startIndex":36,"endIndex":314},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":10,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"createShape":{"objectId":"chl7ft","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"chal7","size":{"width":{"magnitude":11091672,"unit":"EMU"},"height":{"magnitude":896112,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":548640,"translateY":5760720,"unit":"EMU"}}}},{"insertText":{"objectId":"chl7ft","insertionIndex":0,"text":"Sizing this bet:  273M users fail monthly \u00d7 82% of failures being a misread clue = ~224M addressable. At a deliberately pessimistic one-in-five rescue rate, about 45M more successful retrievals a month. Every figure is an estimate and labelled as one.\nKill the whole bet if:  clarifying questions exceed 0.4 per session, fewer than 2 of 3 testers beat their own Google Photos baseline, or anyone asks for the plain grid back.\n"}},{"updateTextStyle":{"objectId":"chl7ft","textRange":{"type":"FIXED_RANGE","startIndex":0,"endIndex":16},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":10.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.12549019607843137,"green":0.12941176470588237,"blue":0.1411764705882353}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"chl7ft","textRange":{"type":"FIXED_RANGE","startIndex":16,"endIndex":252},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":10.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"chl7ft","textRange":{"type":"FIXED_RANGE","startIndex":252,"endIndex":274},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":10.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.8509803921568627,"green":0.18823529411764706,"blue":0.1450980392156863}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"chl7ft","textRange":{"type":"FIXED_RANGE","startIndex":274,"endIndex":426},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":10.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}}]
":{"shapeBackgroundFill":{"solidFill":{"alpha":1,"color":{"rgbColor":{"red":0.09,"green":0.071,"blue":0.047}}}},"outline":{"propertyState":"NOT_RENDERED"}},"fields":"shapeBackgroundFill.solidFill.color,outline.propertyState"}},{"createShape":{"objectId":"root5cap3","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"p6","size":{"width":{"magnitude":2601468,"unit":"EMU"},"height":{"magnitude":603504,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":9038844,"translateY":3712464,"unit":"EMU"}}}},{"insertText":{"objectId":"root5cap3","insertionIndex":0,"text":"\u201c\u2026 around a year ago\u201d\n\u26a0  FOUND, then buried in about 64 photos\n"}},{"updateTextStyle":{"objectId":"root5cap3","textRange":{"type":"FIXED_RANGE","startIndex":0,"endIndex":22},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":10,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.12549019607843137,"green":0.12941176470588237,"blue":0.1411764705882353}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"root5cap3","textRange":{"type":"FIXED_RANGE","startIndex":22,"endIndex":63},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":9.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.12549019607843137,"green":0.12941176470588237,"blue":0.1411764705882353}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"createShape":{"objectId":"root5cb","shapeType":"ROUND_RECTANGLE","elementProperties":{"pageObjectId":"p6","size":{"width":{"magnitude":11091672,"unit":"EMU"},"height":{"magnitude":1115568,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":548640,"translateY":4370832,"unit":"EMU"}}}},{"updateShapeProperties":{"objectId":"root5cb","shapeProperties":{"shapeBackgroundFill":{"solidFill":{"alpha":1,"color":{"rgbColor":{"red":0.9098039215686274,"green":0.9411764705882353,"blue":0.996078431372549}}}},"outline":{"dashStyle":"SOLID","weight":{"magnitude":25400,"unit":"EMU"},"outlineFill":{"solidFill":{"alpha":1,"color":{"rgbColor":{"red":0.10196078431372549,"green":0.45098039215686275,"blue":0.9098039215686274}}}}}},"fields":"shapeBackgroundFill.solidFill.color,outline"}},{"createShape":{"objectId":"root5c","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"p6","size":{"width":{"magnitude":10725912,"unit":"EMU"},"height":{"magnitude":932688,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":731520,"translateY":4462272,"unit":"EMU"}}}},{"insertText":{"objectId":"root5c","insertionIndex":0,"text":"Same photo. Same content word, \u201cbill\u201d. Only the date phrasing changed.  \u201cLast August\u201d was silently read as August 2026 and turned into a hard filter; the bill was from August 2025. Content matching was never broken \u2014 the app could read that bill down to the individual dish. A fifth query, \u201cbill receipt of dinner last year\u201d, also succeeded, because \u201clast year\u201d is unambiguous. Being honestly vague beat being confidently approximate.\n"}},{"updateTextStyle":{"objectId":"root5c","textRange":{"type":"FIXED_RANGE","startIndex":0,"endIndex":70},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":11.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.12549019607843137,"green":0.12941176470588237,"blue":0.1411764705882353}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"root5c","textRange":{"type":"FIXED_RANGE","startIndex":70,"endIndex":378},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":11,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"root5c","textRange":{"type":"FIXED_RANGE","startIndex":378,"endIndex":435},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":11,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.10196078431372549,"green":0.45098039215686275,"blue":0.9098039215686274}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"createShape":{"objectId":"root5ft","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"p6","size":{"width":{"magnitude":11091672,"unit":"EMU"},"height":{"magnitude":713232,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":548640,"translateY":5577840,"unit":"EMU"}}}},{"insertText":{"objectId":"root5ft","insertionIndex":0,"text":"Three time behaviours, and the middle one is the trap:  explicit \u2192 exact filter, works  \u00b7  ambiguous \u2192 silently resolved then hard-filtered, worst case  \u00b7  openly vague \u2192 loose range, works but noisy.\nFirst-party test with a control, 28 Sep 2026. Screenshots cropped to the assistant\u2019s response text only; no personal photos published. Full log in the research repo.\n"}},{"updateTextStyle":{"objectId":"root5ft","textRange":{"type":"FIXED_RANGE","startIndex":0,"endIndex":54},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":9.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.8509803921568627,"green":0.18823529411764706,"blue":0.1450980392156863}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"root5ft","textRange":{"type":"FIXED_RANGE","startIndex":54,"endIndex":201},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":9.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"root5ft","textRange":{"type":"FIXED_RANGE","startIndex":201,"endIndex":367},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":9.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}}]
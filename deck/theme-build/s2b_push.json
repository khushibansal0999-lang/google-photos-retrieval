":0.9764705882352941,"blue":0.9803921568627451}}}},"outline":{"propertyState":"NOT_RENDERED"}},"fields":"shapeBackgroundFill.solidFill.color,outline.propertyState"}},{"createShape":{"objectId":"met2o2","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"p2","size":{"width":{"magnitude":3179369,"unit":"EMU"},"height":{"magnitude":804672,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":8278978,"translateY":4325112,"unit":"EMU"}}}},{"insertText":{"objectId":"met2o2","insertionIndex":0,"text":"The photo, found\nOpened and used, in time to matter. This is the north star.\n"}},{"updateTextStyle":{"objectId":"met2o2","textRange":{"type":"FIXED_RANGE","startIndex":0,"endIndex":17},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":11.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.12549019607843137,"green":0.12941176470588237,"blue":0.1411764705882353}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"met2o2","textRange":{"type":"FIXED_RANGE","startIndex":17,"endIndex":77},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":10,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"createShape":{"objectId":"met2note","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"p2","size":{"width":{"magnitude":11091672,"unit":"EMU"},"height":{"magnitude":1225296,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":548640,"translateY":5303520,"unit":"EMU"}}}},{"insertText":{"objectId":"met2note","insertionIndex":0,"text":"Where the biggest prize sits, and an honest disagreement.  Desk research puts it at the recovery loop in stage 5, where a near miss gives the most information for the least effort. Our own evidence puts it at stage 3: in a controlled test, changing only the date phrasing flipped total failure into an instant answer. The chosen solution does both, exposing its interpretation before it retrieves and asking one narrowing question after a near miss.\nExternal corroboration:  across 83 free-recall photo descriptions, indoor/outdoor appeared 69 times, number of people 64, identity of people 56 and location 54, while exact date proved notably less useful than time of day or broad temporal context.\n"}},{"updateTextStyle":{"objectId":"met2note","textRange":{"type":"FIXED_RANGE","startIndex":0,"endIndex":57},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":10.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.12549019607843137,"green":0.12941176470588237,"blue":0.1411764705882353}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"met2note","textRange":{"type":"FIXED_RANGE","startIndex":57,"endIndex":450},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":10.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"met2note","textRange":{"type":"FIXED_RANGE","startIndex":450,"endIndex":473},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":10.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.8509803921568627,"green":0.18823529411764706,"blue":0.1450980392156863}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"met2note","textRange":{"type":"FIXED_RANGE","startIndex":473,"endIndex":699},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":10.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}}]
 date-blind photo in a 5,000-item library and failed on the same task in a 75,000-item one. The capability does not degrade with the feature. It degrades with the library.\n"}},{"updateTextStyle":{"objectId":"seg4w","textRange":{"type":"FIXED_RANGE","startIndex":0,"endIndex":39},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":8.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.8509803921568627,"green":0.18823529411764706,"blue":0.1450980392156863}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"seg4w","textRange":{"type":"FIXED_RANGE","startIndex":39,"endIndex":314},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":10.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.12549019607843137,"green":0.12941176470588237,"blue":0.1411764705882353}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"seg4w","textRange":{"type":"FIXED_RANGE","startIndex":314,"endIndex":349},"style":{"bold":true,"fontFamily":"Roboto","fontSize":{"magnitude":10.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.10196078431372549,"green":0.45098039215686275,"blue":0.9098039215686274}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"updateTextStyle":{"objectId":"seg4w","textRange":{"type":"FIXED_RANGE","startIndex":349,"endIndex":542},"style":{"bold":false,"fontFamily":"Roboto","fontSize":{"magnitude":10.5,"unit":"PT"},"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.37254901960784315,"green":0.38823529411764707,"blue":0.40784313725490196}}}},"fields":"bold,fontFamily,fontSize,foregroundColor"}},{"createShape":{"objectId":"seg4s0b","shapeType":"ROUND_RECTANGLE","elementProperties":{"pageObjectId":"p7","size":{"width":{"magnitude":2072030,"unit":"EMU"},"height":{"magnitude":1207008,"unit":"EMU"}},"transform":{"scaleX":1,"scaleY":1,"translateX":548640,"translateY":3383280,"unit":"EMU"}}}},{"updateShapeProperties":{"ob